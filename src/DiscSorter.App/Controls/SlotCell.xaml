<!--
    监控页库位图上的一个小格子（只显示，没有按钮）。
    DataContext 是一个 SlotViewModel（在 MonitorView.xaml 里用 DataContext="{Binding Warehouse.Slots[0]}" 指定）。
-->
<UserControl x:Class="DiscSorter.App.Controls.SlotCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DiscSorter.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SlotViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="80"
             d:DesignHeight="50">

    <Border Style="{StaticResource SlotCardBorder}"
            Margin="2"
            Padding="6,3">
        <StackPanel>
            <TextBlock FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}">
                <Run Text="库位"/>
                <Run Text="{Binding SlotNo, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="{Binding StateText}"
                       FontSize="12"
                       Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
        </StackPanel>
    </Border>
</UserControl>
