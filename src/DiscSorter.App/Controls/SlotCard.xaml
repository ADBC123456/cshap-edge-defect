<!--
    仓储管理页上的一个库位卡片。
    DataContext 是一个 SlotViewModel（在 WarehouseView.xaml 里用 DataContext="{Binding Slots[0]}" 指定）。
-->
<UserControl x:Class="DiscSorter.App.Controls.SlotCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DiscSorter.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SlotViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="180"
             d:DesignHeight="120">

    <Border Style="{StaticResource SlotCardBorder}">
        <StackPanel>
            <!-- 库位号 -->
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource HintText}"/>

            <!-- 类别（用类别色） -->
            <TextBlock Text="{Binding CategoryText}"
                       Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,4,0,0"/>

            <!-- 状态和时间 -->
            <TextBlock Text="{Binding StateText}"
                       FontSize="12"/>
            <TextBlock Text="{Binding UpdatedText}"
                       Style="{StaticResource HintText}"/>

            <!-- 按钮：已占用时显示"出库"，待确认时显示"已入库 / 未入库" -->
            <WrapPanel Margin="0,6,0,0">
                <Button Content="出库"
                        Style="{StaticResource SmallButton}"
                        Command="{Binding ClearCommand}"
                        Visibility="{Binding CanClear, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="已入库"
                        Style="{StaticResource SmallButton}"
                        Command="{Binding ConfirmPlacedCommand}"
                        Visibility="{Binding IsNeedsCheck, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="未入库"
                        Style="{StaticResource SmallButton}"
                        Command="{Binding ConfirmEmptyCommand}"
                        Visibility="{Binding IsNeedsCheck, Converter={StaticResource BoolToVisibility}}"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
