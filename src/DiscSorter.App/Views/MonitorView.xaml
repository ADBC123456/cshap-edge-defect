<!--
    监控主画面。
    上：PLC 状态条、报警条。
    左：最新一件的图像、识别结果、最近记录 / 流程日志。
    右：运行控制、库位图（12 个 SlotCell 写死在网格里）、今日统计。
    页面数据来自 MonitorViewModel。
-->
<UserControl x:Class="DiscSorter.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DiscSorter.App.ViewModels"
             xmlns:controls="clr-namespace:DiscSorter.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MonitorViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1150"
             d:DesignHeight="760">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== PLC 状态条 ==================== -->
        <Border Grid.Row="0"
                Style="{StaticResource Panel}"
                Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="PLC：" Style="{StaticResource FieldLabel}" Margin="0"/>
                <TextBlock Text="{Binding PlcName}" FontWeight="SemiBold"/>
                <!-- 连接状态：已连接绿色，未连接红色 -->
                <TextBlock Text="{Binding ConnectionText}" Margin="8,0,24,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="模式：" Style="{StaticResource FieldLabel}" Margin="0"/>
                <TextBlock Text="{Binding ModeText}" FontWeight="SemiBold" Margin="0,0,24,0"/>

                <TextBlock Text="步号：" Style="{StaticResource FieldLabel}" Margin="0"/>
                <TextBlock Text="{Binding StepText}" Margin="0,0,24,0"/>

                <TextBlock Text="任务号：" Style="{StaticResource FieldLabel}" Margin="0"/>
                <TextBlock Text="{Binding JobText}" Margin="0,0,24,0"/>

                <TextBlock Text="信号：" Style="{StaticResource FieldLabel}" Margin="0"/>
                <TextBlock Text="{Binding SignalText}" Margin="0,0,24,0"/>

                <TextBlock Text="心跳：" Style="{StaticResource FieldLabel}" Margin="0"/>
                <TextBlock Text="{Binding HeartbeatText}"/>
            </StackPanel>
        </Border>

        <!-- ==================== 报警条（有报警时才显示） ==================== -->
        <Border Grid.Row="1"
                Margin="0,8,0,0"
                Padding="14,8"
                CornerRadius="6"
                Background="{StaticResource ErrorBackgroundBrush}"
                BorderBrush="{StaticResource ErrorBrush}"
                BorderThickness="1"
                Visibility="{Binding HasAlarm, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding AlarmText}"
                       Foreground="{StaticResource ErrorBrush}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== 左：图像、结果、记录 ==================== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <!-- 最新一件的图像 -->
                <Border Grid.Row="0"
                        Style="{StaticResource ImagePanel}">
                    <Grid>
                        <controls:DetectionViewer Result="{Binding LatestResult}"
                                                  ShowCandidates="False"/>
                        <TextBlock Text="等待第一件工件…（在左侧点“启动”或“单件”）"
                                   Foreground="#9CA3AF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <!-- 已经有过一件以后，隐藏这行提示 -->
                                        <DataTrigger Binding="{Binding HasLatest}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 识别结果 -->
                <Border Grid.Row="1"
                        Style="{StaticResource Panel}"
                        Margin="0,12,0,12"
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="类别：" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LatestCategoryText}" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="目标库位：" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding LatestTargetText}" FontSize="16" FontWeight="Bold"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="图片：" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestFileText}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="类别来源：" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding LatestSourceText}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="耗时：" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LatestTimeText}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="真值：" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding LatestTruthText}"/>
                    </Grid>
                </Border>

                <!-- 最近记录 / 流程日志 -->
                <TabControl Grid.Row="2">
                    <TabItem Header="最近记录">
                        <DataGrid ItemsSource="{Binding RecentRecords}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="任务" Binding="{Binding JobId}"/>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss}"/>
                                <DataGridTextColumn Header="图片" Binding="{Binding FileName}"/>
                                <DataGridTextColumn Header="算法" Binding="{Binding AlgorithmLabel}"/>
                                <DataGridTextColumn Header="入库类别" Binding="{Binding CategoryText}"/>
                                <DataGridTextColumn Header="来源" Binding="{Binding SourceText}"/>
                                <DataGridTextColumn Header="库位" Binding="{Binding TargetText}"/>
                                <DataGridTextColumn Header="真值" Binding="{Binding ExpectedLabel}"/>
                                <DataGridTextColumn Header="正确" Binding="{Binding CorrectText}"/>
                                <DataGridTextColumn Header="总耗时 ms" Binding="{Binding TotalMs, StringFormat=0.0}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="流程日志">
                        <DataGrid ItemsSource="{Binding Messages}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss}"/>
                                <DataGridTextColumn Header="内容" Binding="{Binding Text}" Width="*"/>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <!-- 报警用红字 -->
                                        <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ==================== 右：控制、库位、统计 ==================== -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 运行控制 -->
                    <Border Style="{StaticResource Panel}"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="运行控制"
                                       Style="{StaticResource SectionTitle}"/>
                            <UniformGrid Columns="2">
                                <Button Content="{Binding StartText}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,6,6"
                                        Command="{Binding StartCommand}"/>
                                <Button Content="{Binding StopText}"
                                        Margin="0,0,0,6"
                                        Command="{Binding StopCommand}"/>
                                <Button Content="单件"
                                        Margin="0,0,6,0"
                                        Command="{Binding RunSingleCommand}"/>
                                <Button Content="复位 / 取件确认"
                                        Style="{StaticResource DangerButton}"
                                        Margin="0"
                                        Command="{Binding ResetCommand}"/>
                            </UniformGrid>
                            <TextBlock Text="停止 = 做完当前这一件再停。"
                                       Style="{StaticResource HintText}"
                                       Margin="0,8,0,0"/>
                            <TextBlock Margin="0,4,0,0">
                                <Run Text="类别来源：" Foreground="{StaticResource MutedTextBrush}"/>
                                <Run Text="{Binding CategorySourceText, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="（在“设置”页修改）" Foreground="{StaticResource MutedTextBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 库位图：4 行（列标题 + 行 1～3）× 4 列 -->
                    <Border Style="{StaticResource Panel}"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="库位"
                                       Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 列标题（用该列类别的颜色） -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="2,0,0,4" FontWeight="SemiBold"
                                           Text="{Binding Warehouse.Columns[0].HeaderText}"
                                           Foreground="{Binding Warehouse.Columns[0].SavedCategory, Converter={StaticResource CategoryBrush}}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="2,0,0,4" FontWeight="SemiBold"
                                           Text="{Binding Warehouse.Columns[1].HeaderText}"
                                           Foreground="{Binding Warehouse.Columns[1].SavedCategory, Converter={StaticResource CategoryBrush}}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Margin="2,0,0,4" FontWeight="SemiBold"
                                           Text="{Binding Warehouse.Columns[2].HeaderText}"
                                           Foreground="{Binding Warehouse.Columns[2].SavedCategory, Converter={StaticResource CategoryBrush}}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Margin="2,0,0,4" FontWeight="SemiBold"
                                           Text="{Binding Warehouse.Columns[3].HeaderText}"
                                           Foreground="{Binding Warehouse.Columns[3].SavedCategory, Converter={StaticResource CategoryBrush}}"/>

                                <!-- 12 个库位。库位号 = (列 - 1) × 3 + 行，Slots[库位号 - 1] -->
                                <controls:SlotCell Grid.Row="1" Grid.Column="0" DataContext="{Binding Warehouse.Slots[0]}"/>
                                <controls:SlotCell Grid.Row="2" Grid.Column="0" DataContext="{Binding Warehouse.Slots[1]}"/>
                                <controls:SlotCell Grid.Row="3" Grid.Column="0" DataContext="{Binding Warehouse.Slots[2]}"/>
                                <controls:SlotCell Grid.Row="1" Grid.Column="1" DataContext="{Binding Warehouse.Slots[3]}"/>
                                <controls:SlotCell Grid.Row="2" Grid.Column="1" DataContext="{Binding Warehouse.Slots[4]}"/>
                                <controls:SlotCell Grid.Row="3" Grid.Column="1" DataContext="{Binding Warehouse.Slots[5]}"/>
                                <controls:SlotCell Grid.Row="1" Grid.Column="2" DataContext="{Binding Warehouse.Slots[6]}"/>
                                <controls:SlotCell Grid.Row="2" Grid.Column="2" DataContext="{Binding Warehouse.Slots[7]}"/>
                                <controls:SlotCell Grid.Row="3" Grid.Column="2" DataContext="{Binding Warehouse.Slots[8]}"/>
                                <controls:SlotCell Grid.Row="1" Grid.Column="3" DataContext="{Binding Warehouse.Slots[9]}"/>
                                <controls:SlotCell Grid.Row="2" Grid.Column="3" DataContext="{Binding Warehouse.Slots[10]}"/>
                                <controls:SlotCell Grid.Row="3" Grid.Column="3" DataContext="{Binding Warehouse.Slots[11]}"/>
                            </Grid>
                            <TextBlock Text="{Binding Warehouse.UnmappedText}"
                                       Style="{StaticResource HintText}"
                                       Foreground="{StaticResource WarningBrush}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 今日统计 -->
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="今日统计"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding CountsText}"
                                       FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap"
                                       Margin="0,6,0,0">
                                <Run Text="识别正确率：" Foreground="{StaticResource MutedTextBrush}"/>
                                <Run Text="{Binding AccuracyText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0">
                                <Run Text="单件总耗时：" Foreground="{StaticResource MutedTextBrush}"/>
                                <Run Text="{Binding TimingText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
