<!--
    相机页。
    左边：枚举和打开海康相机、曝光增益、自动运行的图像来源、图片保存。
    右边：拍一张并识别的结果。
    页面数据来自 CameraViewModel。
-->
<UserControl x:Class="DiscSorter.App.Views.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DiscSorter.App.ViewModels"
             xmlns:controls="clr-namespace:DiscSorter.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CameraViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1150"
             d:DesignHeight="760">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左边：相机设置 ==================== -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="相机"
                           Style="{StaticResource PageTitle}"
                           Margin="0,0,0,12"/>

                <!-- 1 枚举和打开 -->
                <Border Style="{StaticResource Panel}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="海康相机（MVS SDK）"
                                   Style="{StaticResource SectionTitle}"/>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Left"
                                    Content="枚举相机"
                                    Command="{Binding EnumerateCommand}"/>
                            <TextBlock Text="{Binding EnumerateText}"
                                       Style="{StaticResource HintText}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </DockPanel>
                        <ComboBox ItemsSource="{Binding Cameras}"
                                  SelectedItem="{Binding SelectedCamera}"
                                  DisplayMemberPath="DisplayText"
                                  Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8">
                            <Run Text="本机网卡："/>
                            <Run Text="{Binding SelectedCamera.HostIpAddress, Mode=OneWay}"/>
                            <Run Text="　相机 IP："/>
                            <Run Text="{Binding SelectedCamera.IpAddress, Mode=OneWay}"/>
                            <Run Text="（两者要在同一网段）"/>
                        </TextBlock>
                        <UniformGrid Columns="2">
                            <Button Content="打开"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,6,0"
                                    Command="{Binding OpenCommand}"/>
                            <Button Content="关闭"
                                    Command="{Binding CloseCommand}"/>
                        </UniformGrid>
                        <TextBlock Text="{Binding CameraStatus}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 2 曝光和增益 -->
                <Border Style="{StaticResource Panel}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="曝光和增益"
                                   Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="曝光时间（微秒）"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="0,0,0,6"
                                     Text="{Binding ExposureText}"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="增益（dB）"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="0,0,0,6"
                                     Text="{Binding GainText}"/>

                            <Button Grid.Row="2"
                                    Grid.Column="1"
                                    Content="应用"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ApplyParametersCommand}"/>
                        </Grid>
                        <TextBlock Text="工位图过曝很严重（纸面都是 255），建议先把曝光调小，让纸面的灰度在 200~240 之间。"
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 3 图像来源和保存 -->
                <Border Style="{StaticResource Panel}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="自动运行时的图像来源"
                                   Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="海康相机"
                                         IsChecked="{Binding UseCamera}"/>
                            <RadioButton Content="图片文件夹（在“设置”页选择）"
                                         IsChecked="{Binding UseCamera, Converter={StaticResource InverseBoolean}}"/>
                        </StackPanel>
                        <TextBlock Text="选“海康相机”但相机没打开时，仍然从图片文件夹取图。"
                                   Style="{StaticResource HintText}"
                                   Margin="0,4,0,10"/>

                        <CheckBox Content="保存相机采到的图片（积累数据集）"
                                  IsChecked="{Binding SaveImages}"
                                  Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="选择…"
                                    Margin="8,0,0,0"
                                    Command="{Binding ChooseSaveFolderCommand}"/>
                            <TextBox Text="{Binding SaveFolder, Mode=OneWay}"
                                     IsReadOnly="True"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Message}"
                           Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 右边：拍照识别 ==================== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                       Margin="0,0,0,8">
                <Button DockPanel.Dock="Left"
                        Content="拍一张并识别"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding GrabAndDetectCommand}"/>
                <TextBlock Text="自动运行时不能手动拍照"
                           Style="{StaticResource HintText}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}"/>
            </DockPanel>

            <Border Grid.Row="1"
                    Style="{StaticResource ImagePanel}">
                <controls:DetectionViewer Result="{Binding Result}"/>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource Panel}"
                    Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="识别结果："
                               Style="{StaticResource FieldLabel}"
                               Margin="0"/>
                    <TextBlock Text="{Binding ResultText}"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
