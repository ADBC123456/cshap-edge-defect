<!--
    PLC 通讯页。
    左边：PLC 类型和连接参数、库位对照（上位机数据库 vs PLC 的 MatState）。
    右边：和 PLC 交换的 5 个变量的当前值、通讯日志（每一次变化和写入）。
    页面数据来自 PlcViewModel。交互流程的说明见 docs\上位机\PLC交互说明.md。
-->
<UserControl x:Class="DiscSorter.App.Views.PlcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DiscSorter.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlcViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1150"
             d:DesignHeight="760">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左边：连接和库位对照 ==================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="PLC 通讯"
                       Style="{StaticResource PageTitle}"
                       Margin="0,0,0,12"/>

            <!-- 连接 -->
            <Border Grid.Row="1"
                    Style="{StaticResource Panel}"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="连接"
                               Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding ModeText}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,2">
                        <RadioButton Content="仿真 PLC"
                                     IsChecked="{Binding UseOpcUa, Converter={StaticResource InverseBoolean}}"/>
                        <RadioButton Content="真实 PLC（OPC UA）"
                                     IsChecked="{Binding UseOpcUa}"/>
                    </StackPanel>
                    <TextBlock Text="切换 PLC 类型后要重启程序。"
                               Style="{StaticResource HintText}"
                               Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="地址"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Margin="0,0,0,6"
                                 Text="{Binding Endpoint}"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="用户名"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,0,0,6"
                                 Text="{Binding User}"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="密码"
                                   Style="{StaticResource FieldLabel}"/>
                        <!-- PasswordBox 不能绑定，密码由 PlcView.xaml.cs 传给 ViewModel -->
                        <PasswordBox x:Name="PasswordInput"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Margin="0,0,0,6"
                                     Padding="6,4"
                                     PasswordChanged="PasswordInput_PasswordChanged"/>

                        <CheckBox Grid.Row="3"
                                  Grid.Column="1"
                                  Content="加密连接（PLCnext 默认要求）"
                                  IsChecked="{Binding UseSecurity}"
                                  Margin="0,0,0,8"/>
                    </Grid>

                    <UniformGrid Columns="2">
                        <Button Content="保存并连接"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,6,0"
                                Command="{Binding ConnectCommand}"/>
                        <Button Content="断开"
                                Command="{Binding DisconnectCommand}"/>
                    </UniformGrid>
                    <TextBlock Text="{Binding ConnectionText}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Message}"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="用户名留空 = 匿名登录（实验室的 EPC 1502 只开放匿名）。密码用 Windows DPAPI 加密后保存在数据库里，只有当前 Windows 用户能解密。"
                               Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 库位对照 -->
            <Border Grid.Row="2"
                    Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="库位对照（上位机数据库 vs PLC 的 MatState）"
                               Style="{StaticResource SectionTitle}"/>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding MismatchText}"
                               Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>
                    <Button DockPanel.Dock="Bottom"
                            Content="以上位机为准同步到 PLC"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Command="{Binding SyncSlotsCommand}"/>
                    <DataGrid ItemsSource="{Binding SlotRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="库位" Binding="{Binding SlotNo}"/>
                            <DataGridTextColumn Header="上位机" Binding="{Binding HostText}"/>
                            <DataGridTextColumn Header="PLC MatState" Binding="{Binding PlcText}"/>
                            <DataGridTextColumn Header="对照" Binding="{Binding ResultText}" Width="*"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- 不一致用红字 -->
                                    <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ==================== 右边：变量和日志 ==================== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 变量表 -->
            <Border Grid.Row="0"
                    Style="{StaticResource Panel}"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="和 PLC 交换的变量（每 50 ms 读一次）"
                               Style="{StaticResource SectionTitle}"/>
                    <DataGrid ItemsSource="{Binding Variables}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="变量" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="方向" Binding="{Binding Direction}"/>
                            <DataGridTextColumn Header="当前值" Binding="{Binding Value}" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="含义" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0">
                        <Run Text="OPC UA 路径：Arp.Plc.Eclr/Rsc_xExecute、Arp.Plc.Eclr/tSTEP、Arp.Plc.Eclr/MainChain1.PC_Category、Arp.Plc.Eclr/MainChain1.PC_TargetSlot、Arp.Plc.Eclr/MainChain1.MatState（见 PlcTags.cs）"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 通讯日志 -->
            <Border Grid.Row="1"
                    Style="{StaticResource Panel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top"
                               Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right"
                                Content="清空日志"
                                Style="{StaticResource SmallButton}"
                                Command="{Binding ClearLogCommand}"/>
                        <TextBlock Text="通讯日志（新的在上面）"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Log}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeText}"/>
                            <DataGridTextColumn Header="方向" Binding="{Binding Direction}"/>
                            <DataGridTextColumn Header="变量" Binding="{Binding Variable}"/>
                            <DataGridTextColumn Header="值" Binding="{Binding Value}"/>
                            <DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="*"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- 上位机写给 PLC 的用蓝字，上位机自己的判断用绿字 -->
                                    <DataTrigger Binding="{Binding Direction}" Value="上位机 → PLC">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Direction}" Value="上位机">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
