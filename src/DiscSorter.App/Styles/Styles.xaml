<!--
    全部颜色和控件样式都在这个文件里。
    想改颜色：只改第 1 部分的 Color 值，所有页面一起变。
    想改按钮、表格的外观：改对应部分的 Setter。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DiscSorter.App.Converters">

    <!-- ==================== 1. 颜色 ==================== -->

    <!-- 背景和边框 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#D9DEE7"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#1F2A44"/>
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#E8ECF2"/>
    <SolidColorBrush x:Key="ImageBackgroundBrush" Color="#111827"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF"/>

    <!-- 强调色和状态色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0B6BCB"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="SlotEmptyBrush" Color="#F8FAFC"/>

    <!-- 5 个类别的颜色：库位卡片、文字、图像上的缺陷轮廓都用这一套 -->
    <SolidColorBrush x:Key="QBrush" Color="#E11D48"/>
    <SolidColorBrush x:Key="HBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="KBrush" Color="#CA8A04"/>
    <SolidColorBrush x:Key="WBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="NGBrush" Color="#64748B"/>

    <!-- ==================== 2. 转换器 ==================== -->

    <!-- bool → 显示/隐藏 -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- bool 取反（单选按钮"文件名真值"用） -->
    <conv:InverseBooleanConverter x:Key="InverseBoolean"/>

    <!-- 类别 → 类别颜色。颜色取自上面第 1 部分 -->
    <conv:CategoryBrushConverter x:Key="CategoryBrush"
                                 QBrush="{StaticResource QBrush}"
                                 HBrush="{StaticResource HBrush}"
                                 KBrush="{StaticResource KBrush}"
                                 WBrush="{StaticResource WBrush}"
                                 NGBrush="{StaticResource NGBrush}"
                                 EmptyBrush="{StaticResource MutedTextBrush}"/>

    <!-- ==================== 3. 文字 ==================== -->

    <!-- 页面标题 -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- 面板标题 -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- 灰色说明文字 -->
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 表单里的标签文字 -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- ==================== 4. 面板 ==================== -->

    <!-- 白底圆角面板，页面上的每个区块都用它 -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <!-- 显示图像的深色面板 -->
    <Style x:Key="ImagePanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ImageBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- ==================== 5. 按钮 ==================== -->

    <!-- 普通按钮（所有 Button 默认都用这个样式） -->
    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="14,4"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="#C3CAD5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主要操作按钮（蓝底白字） -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 危险操作按钮（红字），例如出库 -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
    </Style>

    <!-- 库位卡片上的小按钮 -->
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ==================== 6. 输入控件 ==================== -->

    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="6,3"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,14,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,18,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ==================== 7. 表格 ==================== -->

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="RowBackground" Value="#FFFFFF"/>
        <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#EEF2F7"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <!-- ==================== 8. 库位卡片 ==================== -->
    <!-- 边框颜色随库位状态变化：执行中=橙色，已占用=类别色，待确认=红色 -->
    <Style x:Key="SlotCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SlotEmptyBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,6"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Reserved">
                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Occupied">
                <Setter Property="BorderBrush" Value="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Background" Value="#FFFFFF"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="NeedsCheck">
                <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== 9. 左侧导航（主窗口的页签） ==================== -->

    <!--
        注意：选中时只把"页签标题"的文字设成白色（TextElement.Foreground 设在 TabHeader 上），
        不能设 TabItem 自己的 Foreground，否则页面里的文字会继承成白色。
    -->
    <Style x:Key="NavTabItem" TargetType="TabItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder"
                            Width="150"
                            Margin="8,4"
                            Padding="14,10"
                            CornerRadius="4"
                            Background="Transparent">
                        <ContentPresenter x:Name="TabHeader"
                                          ContentSource="Header"
                                          TextElement.FontSize="15"
                                          TextElement.Foreground="{StaticResource TextBrush}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="#D7DEE8"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
