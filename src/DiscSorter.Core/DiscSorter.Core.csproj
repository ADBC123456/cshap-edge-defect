<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
    <PackageReference Include="MVTec.HalconDotNet" Version="23110.0.0" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.378.182" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="1.5.378.182" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 海康 MVS SDK 的 .NET 接口（从 MVS 安装目录 Development\DotNet\win64\netstandard2.0 复制）。
         运行时还需要安装 MVS 客户端或 Runtime，它提供底层的 MvCameraControl.dll -->
    <Reference Include="MvCameraControl.Net">
      <HintPath>..\..\lib\MVS\MvCameraControl.Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
