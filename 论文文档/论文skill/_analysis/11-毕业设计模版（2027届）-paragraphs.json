  },
  {
    "index": 345,
    "style": "Normal",
    "text": "    LCD1602_RW = 0;"
  },
  {
    "index": 346,
    "style": "Normal",
    "text": "    LCD1602_DB = cmd;"
  },
  {
    "index": 347,
    "style": "Normal",
    "text": "    LCD1602_E  = 1;"
  },
  {
    "index": 348,
    "style": "Normal",
    "text": "    LCD1602_E  = 0;"
  },
  {
    "index": 349,
    "style": "Normal",
    "text": "}"
  },
  {
    "index": 350,
    "style": "Normal",
    "text": "/* 向LCD1602液晶写入一字节数据，dat-待写入数据值 */"
  },
  {
    "index": 351,
    "style": "Normal",
    "text": "void LcdWriteDat(unsigned char dat)"
  },
  {
    "index": 352,
    "style": "Normal",
    "text": "{"
  },
  {
    "index": 353,
    "style": "Normal",
    "text": "    LcdWaitReady();"
  },
  {
    "index": 354,
    "style": "Normal",
    "text": "    LCD1602_RS = 1;"
  },
  {
    "index": 355,
    "style": "Normal",
    "text": "    LCD1602_RW = 0;"
  },
  {
    "index": 356,
    "style": "Normal",
    "text": "    LCD1602_DB = dat;"
  },
  {
    "index": 357,
    "style": "Normal",
    "text": "    LCD1602_E  = 1;"
  },
  {
    "index": 358,
    "style": "Normal",
    "text": "    LCD1602_E  = 0;"
  },
  {
    "index": 359,
    "style": "Normal",
    "text": "}"
  },
  {
    "index": 360,
    "style": "Normal",
    "text": "/* 设置显示RAM起始地址，亦即光标位置，(x,y)-对应屏幕上的字符坐标 */"
  },
  {
    "index": 361,
    "style": "Normal",
    "text": "void LcdSetCursor(unsigned char x, unsigned char y)"
  },
  {
    "index": 362,
    "style": "Normal",
    "text": "{"
  },
  {
    "index": 363,
    "style": "Normal",
    "text": "    unsigned char addr;"
  },
  {
    "index": 364,
    "style": "Normal",
    "text": "    "
  },
  {
    "index": 365,
    "style": "Normal",
    "text": "    if (y == 0)  //由输入的屏幕坐标计算显示RAM的地址"
  },
  {
    "index": 366,
    "style": "Normal",
    "text": "        addr = 0x00 + x;  //第一行字符地址从0x00起始"
  },
  {
    "index": 367,
    "style": "Normal",
    "text": "    else"
  },
  {
    "index": 368,
    "style": "Normal",
    "text": "        addr = 0x40 + x;  //第二行字符地址从0x40起始"
  },
  {
    "index": 369,
    "style": "Normal",
    "text": "    LcdWriteCmd(addr | 0x80);  //设置RAM地址"
  },
  {
    "index": 370,
    "style": "Normal",
    "text": "}"
  },
  {
    "index": 371,
    "style": "Normal",
    "text": "/* 在液晶上显示字符串，(x,y)-对应屏幕上的起始坐标，str-字符串指针 */"
  },
  {
    "index": 372,
    "style": "Normal",
    "text": "void LcdShowStr(unsigned char x, unsigned char y, unsigned char *str)"
  },
  {
    "index": 373,
    "style": "Normal",
    "text": "{"
  },
  {
    "index": 374,
    "style": "Normal",
    "text": "    LcdSetCursor(x, y);   //设置起始地址"
  },
  {
    "index": 375,
    "style": "Normal",
    "text": "    while (*str != '\\0')  //连续写入字符串数据，直到检测到结束符"
  },
  {
    "index": 376,
    "style": "Normal",
    "text": "    {"
  },
  {
    "index": 377,
    "style": "Normal",
    "text": "        LcdWriteDat(*str++);"
  },
  {
    "index": 378,
    "style": "Normal",
    "text": "    }"
  },
  {
    "index": 379,
    "style": "Normal",
    "text": "}"
  },
  {
    "index": 380,
    "style": "Normal",
    "text": "/* 初始化1602液晶 */"
  },
  {
    "index": 381,
    "style": "Normal",
    "text": "void InitLcd1602()"
  },
  {
    "index": 382,
    "style": "Normal",
    "text": "{"
  },
  {
    "index": 383,
    "style": "Normal",
    "text": "    LcdWriteCmd(0x38);  //16*2显示，5*7点阵，8位数据接口"
  },
  {
    "index": 384,
    "style": "Normal",
    "text": "    LcdWriteCmd(0x0C);  //显示器开，光标关闭"
  },
  {
    "index": 385,
    "style": "Normal",
    "text": "    LcdWriteCmd(0x06);  //文字不动，地址自动+1"
  },
  {
    "index": 386,
    "style": "Normal",
    "text": "    LcdWriteCmd(0x01);  //清屏"
  },
  {
    "index": 387,
    "style": "Normal",
    "text": "}"
  },
  {
    "index": 388,
    "style": "Normal",
    "text": "void Delay_Ms (unsigned int a)"
  },
  {
    "index": 389,
    "style": "Normal",
    "text": "{"
  },
  {
    "index": 390,
    "style": "Normal",
    "text": "\tunsigned int i;"
  },
  {
    "index": 391,
    "style": "Normal",
    "text": "\twhile( a-- != 0)"
  },
  {
    "index": 392,
    "style": "Normal",
    "text": "\t{"
  },
  {
    "index": 393,
    "style": "Normal",
    "text": "\t\tfor(i = 0; i < 600; i++);"
  },
  {
    "index": 394,
    "style": "Normal",
    "text": "\t}"
  },
  {
    "index": 395,
    "style": "Normal",
    "text": "} "
  },
  {
    "index": 396,
    "style": "Normal",
    "text": "long kssj()   //开始收集"
  },
  {
    "index": 397,
    "style": "Normal",
    "text": " {"
  },
  {
    "index": 398,
    "style": "Normal",
    "text": "   unsigned char i;"
  },
  {
    "index": 399,
    "style": "Normal",
    "text": ""
  },
  {
    "index": 400,
    "style": "Normal",
    "text": "     bADcs = 0;//当ADC0832未工作时其CS输入端应为高电平，此时芯片禁用."
  },
  {
    "index": 401,
    "style": "Normal",
    "text": "\t bADcl=0;"
  },
  {
    "index": 402,
    "style": "Normal",
    "text": "\t bADda=1;"
  },
  {
    "index": 403,
    "style": "Normal",
    "text": "\t bADcl=1;"
  },
  {
    "index": 404,
    "style": "Normal",
    "text": "\t bADcl=0;//i down"
  },
  {
    "index": 405,
    "style": "Normal",
    "text": "\t bADda=1;"
  },
  {
    "index": 406,
    "style": "Normal",
    "text": "\t bADcl=1;"
  },
  {
    "index": 407,
    "style": "Normal",
    "text": "\t bADcl=0;\t//   2 down"
  },
  {
    "index": 408,
    "style": "Normal",
    "text": "\t bADda=0;"
  },
  {
    "index": 409,
    "style": "Normal",
    "text": "\t bADcl=1;"
  },
  {
    "index": 410,
    "style": "Normal",
    "text": "\t bADcl=0;\t//   3 down"
  },
  {
    "index": 411,
    "style": "Normal",
    "text": "\t bADda=1;"
  },
  {
    "index": 412,
    "style": "Normal",
    "text": "\t bADcl=1;"
  },
  {
    "index": 413,
    "style": "Normal",
    "text": "\t bADcl=0;\t//   4 down"
  },
  {
    "index": 414,
    "style": "Normal",
    "text": ""
  },
  {
    "index": 415,
    "style": "Normal",
    "text": "\t for(i=8;i>0;i--)"
  },
  {
    "index": 416,
    "style": "Normal",
    "text": "\t \t{"
  },
  {
    "index": 417,
    "style": "Normal",
    "text": "\t\t"
  },
  {
    "index": 418,
    "style": "Normal",
    "text": "\t \tdata1<<=1;"
  },
  {
    "index": 419,
    "style": "Normal",
    "text": "\t \tbADcl=0;"
  },
  {
    "index": 420,
    "style": "Normal",
    "text": "\t\tbADcl=1;"
  },
  {
    "index": 421,
    "style": "Normal",
    "text": "\t\tif(bADda==1) data1|=0x01;"
  },
  {
    "index": 422,
    "style": "Normal",
    "text": "\t\t   \tbADda=1;"
  },
  {
    "index": 423,
    "style": "Normal",
    "text": "\t \t}"
  },
  {
    "index": 424,
    "style": "Normal",
    "text": "\t\t bADcs=1;"
  },
  {
    "index": 425,
    "style": "Normal",
    "text": "\t \t"
  },
  {
    "index": 426,
    "style": "Normal",
    "text": "       Value=500-data1*1.96;"
  },
  {
    "index": 427,
    "style": "Normal",
    "text": "\t "
  },
  {
    "index": 428,
    "style": "Normal",
    "text": "\t   if(Value<0)Value=0;"
  },
  {
    "index": 429,
    "style": "Normal",
    "text": "\t   return Value;"
  },
  {
    "index": 430,
    "style": "Normal",
    "text": " }"
  },
  {
    "index": 431,
    "style": "Normal",
    "text": ""
  },
  {
    "index": 432,
    "style": "Normal",
    "text": "void main()"
  },
  {
    "index": 433,
    "style": "Normal",
    "text": "{"
  },
  {
    "index": 434,
    "style": "Normal",
    "text": "  unsigned char len_w;"
  },
  {
    "index": 435,
    "style": "Normal",
    "text": "  unsigned char str_yw[12];//光照强度"
  },
  {
    "index": 436,
    "style": "Normal",
    "text": "  InitLcd1602();     //初始化液晶"
  },
  {
    "index": 437,
    "style": "Normal",
    "text": "  LcdShowStr(0, 1,\"Light:\");\t//单位勒克斯（lux或lx）"
  },
  {
    "index": 438,
    "style": "Normal",
    "text": " // LcdShowStr(0, 1,\"Set:300Lx\");\t//单位勒克斯（lux或lx）"
  },
  {
    "index": 439,
    "style": "Normal",
    "text": "  while(1)"
  },
  {
    "index": 440,
    "style": "Normal",
    "text": " {"
  },
  {
    "index": 441,
    "style": "Normal",
    "text": "    Delay_Ms(100);"
  },
  {
    "index": 442,
    "style": "Normal",
    "text": "    kssj();  //开始检测光照强度"
  },
  {
    "index": 443,
    "style": "Normal",
    "text": "\t        str_yw[0] = Value/100+0x30;"
  },
  {
    "index": 444,
    "style": "Normal",
    "text": "            str_yw[1] = Value%100/10+0x30;"
  },
  {
    "index": 445,
    "style": "Normal",
    "text": "            str_yw[2] = Value%10+0x30;"
  },
  {
    "index": 446,
    "style": "Normal",
    "text": "\t\t    str_yw[3] = 'L';"
  },
  {
    "index": 447,
    "style": "Normal",
    "text": "            str_yw[4] = 'x';"
  },
  {
    "index": 448,
    "style": "Normal",
    "text": "\t\t\tstr_yw[5] = '\\0';"
  },
  {
    "index": 449,
    "style": "Normal",
    "text": ""
  },
  {
    "index": 450,
    "style": "Normal",
    "text": "            LcdShowStr(6, 1,str_yw);"
  },
  {
    "index": 451,
    "style": "Normal",
    "text": ""
  },
  {
    "index": 452,
    "style": "Normal",
    "text": " }"
  },
  {
    "index": 453,
    "style": "Normal",
    "text": "}"
  },
  {
    "index": 454,
    "style": "Normal",
    "text": "/* 整型数转换为字符串，str-字符串指针，dat-待转换数，返回值-字符串长度 */"
  },
  {
    "index": 455,
    "style": "Normal",
    "text": "unsigned char IntToString(unsigned char *str, int dat)"
  },
  {
    "index": 456,
    "style": "Normal",
    "text": "{"
  },
  {
    "index": 457,
    "style": "Normal",
    "text": "    signed char i = 0;"
  },
  {
    "index": 458,
    "style": "Normal",
    "text": "    unsigned char len = 0;"
  },
  {
    "index": 459,
    "style": "Normal",
    "text": "    unsigned char buf[6];"
  },
  {
    "index": 460,
    "style": "Normal",
    "text": "    "
  },
  {
    "index": 461,
    "style": "Normal",
    "text": "    if (dat < 0)  //如果为负数，首先"
  },
  {
    "index": 462,
    "style": "Normal",
    "text": "\t"
  },
  {
    "index": 463,
    "style": "Normal",
    "text": "    {"
  },
  {
    "index": 464,
    "style": "Normal",
    "text": "        dat = -dat;"
  },
  {
    "index": 465,
    "style": "Normal",
    "text": "        *str++ = '-';"
  },
  {
    "index": 466,
    "style": "Normal",
    "text": "        len++;"
  },
  {
    "index": 467,
    "style": "Normal",
    "text": "    }"
  },
  {
    "index": 468,
    "style": "Normal",
    "text": "    do {          //先转换为低位在前的十进制数组"
  },
  {
    "index": 469,
    "style": "Normal",
    "text": "        buf[i++] = dat % 10;"
  },
  {
    "index": 470,
    "style": "Normal",
    "text": "        dat /= 10;"
  },
  {
    "index": 471,
    "style": "Normal",
    "text": "    } while (dat > 0);"
  },
  {
    "index": 472,
    "style": "Normal",
    "text": "    len += i;     //i最后的值就是有效字符的个数"
  },
  {
    "index": 473,
    "style": "Normal",
    "text": "    while (i-- > 0)   //将数组值转换为ASCII码反向拷贝到接收指针上"
  },
  {
    "index": 474,
    "style": "Normal",
    "text": "    {"
  },
  {
    "index": 475,
    "style": "Normal",
    "text": "        *str++ = buf[i] + '0';"
  },
  {
    "index": 476,
    "style": "Normal",
    "text": "    }"
  },
  {
    "index": 477,
    "style": "Normal",
    "text": ""
  },
  {
    "index": 478,
    "style": "Normal",
    "text": "    *str = '\\0';  //添加字符串结束符"
  },
  {
    "index": 479,
    "style": "Normal",
    "text": "    "
  },
  {
    "index": 480,
    "style": "Normal",
    "text": "    return len;   //返回字符串长度"
  },
  {
    "index": 481,
    "style": "Normal",
    "text": "}"
  }
]