    "text": "/* 等待液晶准备好 */"
  },
  {
    "index": 327,
    "style": "Normal",
    "text": "void LcdWaitReady()"
  },
  {
    "index": 328,
    "style": "Normal",
    "text": "{"
  },
  {
    "index": 329,
    "style": "Normal",
    "text": "    unsigned char sta;"
  },
  {
    "index": 330,
    "style": "Normal",
    "text": "    "
  },
  {
    "index": 331,
    "style": "Normal",
    "text": "    LCD1602_DB = 0xFF;"
  },
  {
    "index": 332,
    "style": "Normal",
    "text": "    LCD1602_RS = 0;"
  },
  {
    "index": 333,
    "style": "Normal",
    "text": "    LCD1602_RW = 1;"
  },
  {
    "index": 334,
    "style": "Normal",
    "text": "    do {"
  },
  {
    "index": 335,
    "style": "Normal",
    "text": "        LCD1602_E = 1;"
  },
  {
    "index": 336,
    "style": "Normal",
    "text": "        sta = LCD1602_DB; //读取状态字"
  },
  {
    "index": 337,
    "style": "Normal",
    "text": "        LCD1602_E = 0;"
  },
  {
    "index": 338,
    "style": "Normal",
    "text": "    } while (sta & 0x80); //bit7等于1表示液晶正忙，重复检测直到其等于0为止"
  },
  {
    "index": 339,
    "style": "Normal",
    "text": "}"
  },
  {
    "index": 340,
    "style": "Normal",
    "text": "/* 向LCD1602液晶写入一字节命令，cmd-待写入命令值 */"
